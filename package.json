{
  "name": "poko-website-builder",
  "version": "0.0.2",
  "author": {
    "name": "Marc Coët",
    "url": "https://www.m4rr.co/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4rrc0/poko-website-builder.git"
  },
  "type": "module",
  "main": "./eleventy.config.js",
  "exports": {
    ".": "./eleventy.config.js",
    "./eleventy": "./eleventy.config.js",
    "./env": "./env.config.js",
    "./env/init": "./src/env/init.js",
    "./cms-config": "./src/config-11ty/plugins/cms-config/config.js",
    "./cli": "./scripts/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "poko": "scripts/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "LICENSES",
    "assets",
    "eleventy.config.js",
    "env.config.js",
    "scripts",
    "src"
  ],
  "dependencies": {
    "@sveltia/cms": "^0.215.0",
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-fetch": "^5.1.0",
    "@11ty/eleventy-img": "^6.0.3",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-directory-output": "^1.0.1",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@code-blocks/charts": "^0.1.9",
    "@code-blocks/eleventy-plugin": "^0.1.8",
    "@mdit/plugin-container": "^0.22.1",
    "@quasibit/eleventy-plugin-sitemap": "^2.2.0",
    "@sindresorhus/slugify": "^2.2.1",
    "@tabler/icons": "^3.34.0",
    "chalk": "^5.4.1",
    "dayjs": "^1.11.13",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.7",
    "eleventy-plugin-icons": "^4.5.3",
    "eleventy-plugin-robotstxt": "^1.0.2",
    "eleventy-plugin-youtube-embed": "^1.13.2",
    "fast-glob": "^3.3.3",
    "fast-sort": "^3.4.1",
    "hash-sum": "^2.0.0",
    "he": "^1.2.0",
    "html-rewriter-wasm": "^0.4.1",
    "js-yaml": "^4.3.1",
    "lightningcss": "^1.30.1",
    "luxon": "^3.7.2",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-bracketed-spans": "^1.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "memoize": "^10.1.0",
    "simple-icons": "^15.5.0",
    "unocss": "^66.4.2",
    "utopia-core": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2",
    "wrangler": "^4.61.1"
  },
  "bugs": {
    "url": "https://github.com/m4rrc0/poko-website-builder/issues"
  },
  "description": "A low cost, high power website builder you trully own",
  "engines": {
    "bun": ">=1.2.22",
    "node": ">=22.6"
  },
  "homepage": "https://github.com/m4rrc0/poko-website-builder#readme",
  "keywords": [
    "website-builder",
    "cms",
    "headless-cms",
    "eleventy",
    "11ty",
    "svelte"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "node scripts/run.js build",
    "cf-build": "node scripts/run.js build",
    "build:gh-pages": "node scripts/run.js build:gh-pages",
    "build:demo": "node scripts/run.js build:demo",
    "build:content": "node scripts/run.js build:content",
    "dev": "node scripts/run.js dev",
    "dev:demo": "node scripts/run.js dev:demo",
    "dev:content": "node scripts/run.js dev:content",
    "dev:script": "node scripts/run.js dev:script",
    "poko": "node scripts/cli.js",
    "pack:check": "npm pack --dry-run",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:rc": "npm version prerelease --preid=rc",
    "preversion": "npm run pack:check",
    "postversion": "git push --follow-tags",
    "start": "node scripts/run.js start",
    "clean": "rm -rf dist",
    "clean:modules": "rm -rf dist node_modules",
    "clean:cache": "rm -rf dist .cache"
  }
}
