# All the environment variables are optional

# Content directory of this website, relative to the project root
# CONTENT_DIR=_content
# Output directory
# OUTPUT_DIR=dist

# Public URL of the production website
# PROD_URL=https://example.com
# Branch built by the host (inferred from git when omitted)
# BRANCH=main

# Sveltia CMS setup
# CMS_BACKEND=github
# CMS_REPO=owner/repo
# CMS_AUTH_URL="https://sveltia-cms-auth.my-account.workers.dev/"

# GitHub OAuth device flow (see functions/README.md): public client ID of the
# shared poko OAuth app — not a secret. When set, /admin shows a "Sign in with
# GitHub" card that needs no per-site OAuth app or secrets.
# POKO_GITHUB_CLIENT_ID="Ov23li…"
# Device-flow relay base URL — same-origin Pages Function by default; override
# for non-Cloudflare-Pages deployments pointing at an equivalent relay.
# CMS_AUTH_RELAY_URL="/cms-auth"

# Advanced
# Points to a CONTENT_DIR outside of the root of the project
# Legacy: We were using this when poko was not published as an npm package
# CONTENT_PATH_PREFIX="../../other-content-source/poko-website-builder"

# Setting this to "draft" makes content entries with a status of "draft" appear as "published"
# Default: "production" on the main branch and "draft" on other branches so we can preview draft content
# BUILD_LEVEL="draft"

# CMS_IMPORT="npm" # cdn, npm, "<relative-path>", local

# NODE_ENV=development
# DEBUG=true