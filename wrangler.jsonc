{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poko-website-builder",
  "compatibility_date": "2025-03-10",
  "pages_build_output_dir": "./dist", // Replaced on Workers by `assets.directory`
  // "preview_urls": true, // Default
  // "compatibility_flags": ["nodejs_compat"], // Was required for keystatic
  "send_metrics": true,
  "vars": {
    "BUN_VERSION": "1.3.13",
    "UNSTABLE_PRE_BUILD": "if command -v bun >/dev/null 2>&1; then bun i; else npm i; fi",
    "SKIP_DEPENDENCY_INSTALL": "true"
  }
}